{
  "name": "prelude",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "install:mac": "pnpm build:tui && tauri build --bundles app && rm -rf /Applications/Prelude.app && cp -R src-tauri/target/release/bundle/macos/Prelude.app /Applications/",
    "build:tui": "tsc --noEmit -p tsconfig.tui.json && esbuild src/tui/main.tsx --bundle --platform=node --format=esm --packages=external --jsx=automatic --target=node22 --outfile=dist-tui/prelude-tui.mjs --log-level=warning",
    "tui": "pnpm build:tui && PRELUDE_CORE=src-tauri/target/debug/prelude node dist-tui/prelude-tui.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "~2.5.0",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-opener": "^2",
    "ink": "^8.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^4.5.0",
    "string-width": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.4"
  }
}
